# Copy to .env and fill in. Never commit .env.

# Local Postgres via `docker compose up -d`. For production use a hosted
# Postgres (Neon, Supabase) and paste its pooled connection string here.
DATABASE_URL="postgresql://market:market@localhost:5433/market?schema=public"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Base URL of the app. Set to the deployed URL in production.
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated emails granted admin rights on first sign-in. Admins can
# create and resolve markets.
ADMIN_EMAILS="aniketsingh8072@gmail.com"

# hCaptcha — guards the email/password sign-in and sign-up forms. Get real keys
# at https://dashboard.hcaptcha.com. The values below are hCaptcha's public TEST
# credentials: the widget always solves and siteverify always passes, so local
# dev works without an account — replace both before deploying. Leaving
# HCAPTCHA_SECRET blank disables the check entirely (dev convenience; logged).
# HCAPTCHA_SITEKEY is public and sent to the browser; HCAPTCHA_SECRET is not.
HCAPTCHA_SITEKEY="10000000-ffff-ffff-ffff-000000000001"
HCAPTCHA_SECRET="0x0000000000000000000000000000000000000000"

# How many proxies sit in front of the app. IP-keyed rate limits read this many
# hops back from the RIGHT of x-forwarded-for, because only the entries our own
# infrastructure appended are trustworthy — the left-hand ones are attacker
# controlled. Leave at 1 for Vercel or a single reverse proxy. Setting this too
# high lets clients spoof their IP and defeat the signup limit.
TRUSTED_PROXY_COUNT="1"
